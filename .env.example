# Berkas environment
# Copy to .env and fill only the keys you actually have.

# Flask
FLASK_ENV=development
FLASK_DEBUG=false
# Required in production. Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Storage
DATABASE_URL=sqlite:///berkas.db
UPLOAD_FOLDER=
MAX_CONTENT_LENGTH=16777216
MAX_WORKERS=6
# Maximum tool runs started by one create or pivot batch. The rest are deferred.
MAX_RUNS_PER_BATCH=12

# Cache. Set to 0 to disable.
TOOL_CACHE_TTL=3600
SUMMARY_CACHE_TTL=86400

# Optional shared access token. When set, every API call needs
# header X-Berkas-Token or ?token=. Leave empty for local-only use.
BERKAS_API_TOKEN=

# AI summary. Default provider is Groq. Missing keys fall back to a local summary.
# AI_PROVIDER: auto, groq, openai, openai_compatible, or none.
AI_PROVIDER=auto
AI_MODEL=
# Only needed for openai_compatible providers. Must be HTTPS.
AI_BASE_URL=
AI_TIMEOUT_S=30

# Public audience hides most of email, phone, NIK, and NPWP by default.
PUBLIC_REDACTION=true

# Tool keys. Missing keys are reported per tool, never invented.
GROQ_API_KEY=
OPENAI_API_KEY=
VT_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
HIBP_API_KEY=
